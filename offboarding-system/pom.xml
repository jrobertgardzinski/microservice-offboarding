<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The use cases, one per door into the process manager: open a case, record a confirmation,
         sweep the overdue ones. Plus the SagaStore port they work over.

         Framework-free and transport-free, exactly like the identity service's security-system.
         A monolith takes this module as it is. -->
    <parent>
        <groupId>com.jrobertgardzinski</groupId>
        <artifactId>microservice-offboarding</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>offboarding-system</artifactId>
    <properties>
        <offboarding.repo.root>${project.parent.basedir}</offboarding.repo.root>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>offboarding-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>observation</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <!-- the words this saga shares with identity and with every participant: the message names
             and who asked for the closure. They were a final class of constants here, an enum in
             identity and a private String in each content service. -->
        <dependency>
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>account-closure</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <!-- SagaStore's fake and contract, now beside the port -->
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>offboarding-domain</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
