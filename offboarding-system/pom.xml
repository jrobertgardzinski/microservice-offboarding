<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The use cases, one per door into the process manager: open a case, record a confirmation,
         sweep the overdue ones. The SagaStore port they work over lives in offboarding-domain,
         beside the saga's data.

         Framework-free and transport-free, exactly like the identity service's security-system.
         A monolith takes this module as it is. -->
    <parent>
        <groupId>com.jrobertgardzinski</groupId>
        <artifactId>microservice-offboarding</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>offboarding-system</artifactId>
    <properties>
        <offboarding.repo.root>${project.parent.basedir}</offboarding.repo.root>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>offboarding-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- test scope only, and only because of the fake: FakeSagaStore (from the domain's
             test-jar) opens a case with a ClosureInitiator, and a test-scoped dependency of the
             domain does not travel with its test-jar. No use case here says a closure word. -->
        <dependency>
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>account-closure</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- SagaStore's fake and contract, now beside the port -->
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>offboarding-domain</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
