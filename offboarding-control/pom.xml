<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The decisions: the three use cases over the SagaStore port, and the switchboard that
         routes a fact or a confirmation to the right one and answers with what to publish.

         What is NOT here is the whole argument for the module existing. There is no dependency on
         offboarding-boundary, so nothing in this module can reach Kafka, JDBC, Helidon or the
         metrics exporter — including the Gherkin scenarios, which used to import the router from
         the transport package and now cannot. Jackson is the one concession: the events this
         service ferries are opaque JSON, and reading a type off an envelope is a decision, not a
         transport detail. -->
    <parent>
        <groupId>com.jrobertgardzinski</groupId>
        <artifactId>microservice-offboarding</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>offboarding-control</artifactId>
    <properties>
        <offboarding.repo.root>${project.parent.basedir}</offboarding.repo.root>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>offboarding-entity</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <!-- the port this service states its own facts through; the facts stay in entity -->
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>observation</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <!-- reading an event without letting a bad one wedge the topic, and saying what was
                 wrong with it without putting anybody's address in the log -->
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>envelope</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- the scenarios and the contract tests are the saga's own, so this module publishes
                 its fixtures for the boundary tests that drive the real loop over a real broker -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
