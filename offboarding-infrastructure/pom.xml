<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Everything with the outside in it: the Kafka loop, the JDBC store and its migrations, the
         probes, the metrics exporter, and Main — the composition root that decides which adapter
         each port gets.

         This is the deployable: it keeps the old artifact name, so the Dockerfile, the compose
         build and the CI boot smoke still find microservice-offboarding.jar (under this module's
         target/ now). -->
    <parent>
        <groupId>com.jrobertgardzinski</groupId>
        <artifactId>microservice-offboarding</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>offboarding-infrastructure</artifactId>
    <properties>
        <offboarding.repo.root>${project.parent.basedir}</offboarding.repo.root>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>offboarding-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>offboarding-application</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- the in-memory store the router fixture runs on; the loop tests drive the real
                 chain against a real broker and must not grow a second copy of it -->
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>offboarding-system</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- SagaStore's fake and contract, now beside the port -->
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>offboarding-domain</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>microservice-offboarding</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-libs</id>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
